# Uploaded files are never executed as code, even if a bad file somehow
# ends up here — this directory only ever serves images and documents.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|asp|aspx|exe|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
